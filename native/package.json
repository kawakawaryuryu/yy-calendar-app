{
  "name": "yy-calendar-native-mock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node scripts/start.mjs",
    "qr": "node scripts/qr.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "toqr": "0.1.1",
    "typescript": "~6.0.3"
  }
}
